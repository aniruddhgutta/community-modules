From aa3132c58abcbc37a46ee11ceab2e59620974ef9 Mon Sep 17 00:00:00 2001
From: aniruddhgutta <aniruddhgutta@disroot.org>
Date: Sun, 8 Nov 2026 19:11:06 +0530
Subject: [PATCH] Read AC state from sysfs instead of upower

upower was only used for is_on_battery(), which feeds the per-state
AC/DC settings (sliders, min/max perf pct) and the ppd default EPP.
Read /sys/class/power_supply directly so lpmd doesn't need upowerd or
upower-glib. AC/DC changes are now picked up when the next state is
applied rather than pushed by a signal.
---
 Makefile.am     |  2 --
 configure.ac    |  2 --
 src/lpmd_proc.c | 67 +++++++++++++++----------------------------------
 3 files changed, 20 insertions(+), 51 deletions(-)

diff --git a/Makefile.am b/Makefile.am
index 32a3da6..c8c02fe 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -12,7 +12,6 @@ AM_CFLAGS = \
 	$(XML_CFLAGS) \
 	-DTDRUNDIR=\"$(lpmd_rundir)\" \
 	-DTDCONFDIR=\"$(lpmd_confdir)\" \
-	$(UPOWER_CFLAGS) \
 	$(CFLAGS) \
 	$(libnl30_CFLAGS)\
 	$(libnlgenl30_CFLAGS) \
@@ -40,7 +39,6 @@ intel_lpmd_LDADD = \
 	-lm \
 	$(LIBDL) \
 	$(XML_LIBS) \
-	$(UPOWER_LIBS) \
 	$(libnlgenl30_LIBS) \
 	$(SYSTEMD_LIBS)
 
diff --git a/configure.ac b/configure.ac
index 93f75eb..8de4361 100644
--- a/configure.ac
+++ b/configure.ac
@@ -77,8 +77,6 @@ AS_IF([test "x$with_libsystemd" != xno], [
 	AC_DEFINE([HAVE_LIBSYSTEMD], [1], [Build with sd-bus support])
 ])
 
-PKG_CHECK_MODULES([UPOWER], [upower-glib])
-
 AC_PATH_PROG([GDBUS_CODEGEN],[gdbus-codegen])
 
 AC_PROG_CC
diff --git a/src/lpmd_proc.c b/src/lpmd_proc.c
index 8f5c219..76f3a75 100644
--- a/src/lpmd_proc.c
+++ b/src/lpmd_proc.c
@@ -2,7 +2,6 @@
 /* Copyright (C) 2026 Intel Corporation */
 
 #include "lpmd.h"
-#include <upower.h>
 #include <time.h>
 #include "wlt_proxy.h"
 
@@ -13,8 +12,6 @@ struct lpmd_config_t *get_lpmd_config(void)
 	return &lpmd_config;
 }
 
-static UpClient *upower_client;
-
 static pthread_mutex_t lpmd_mutex;
 
 int lpmd_lock(void)
@@ -78,8 +75,6 @@ void lpmd_terminate(void)
 
 	lpmd_send_message (TERMINATE, 0, NULL);
 	sleep (1);
-	if (upower_client)
-		g_clear_object(&upower_client);
 }
 
 void lpmd_force_on(void)
@@ -191,51 +186,30 @@ static int connect_to_power_profile_daemon(void)
 	return 1;
 }
 
-static int battery_mode = -1;
-
+/* AC state from sysfs: on battery iff a non-battery supply exists and none is online */
 int is_on_battery(void)
 {
-	if (battery_mode < 0)
-		battery_mode = up_client_get_on_battery(upower_client);
-
-	return battery_mode;
-}
-
-static void upower_daemon_cb(UpClient *client, GParamSpec *pspec, gpointer user_data)
-{
-	static int mode = -1;
-
-	battery_mode = up_client_get_on_battery(upower_client);
-	if (mode != battery_mode) {
-		process_balance_slider_default_update(&lpmd_config);
-		process_slider_offset_default_update(&lpmd_config);
-	}
-
-	mode = battery_mode;
-}
-
-static void connect_to_upower_daemon(void)
-{
-	GError *error = NULL;
-	GPtrArray *devices;
-	UpDevice *device;
-	int i;
-
-	upower_client = up_client_new_full(NULL, &error);
-	if (!upower_client) {
-		g_warning("Cannot connect to upowerd: %s", error->message);
-		g_error_free(error);
-		return;
+	const char *dir = "/sys/class/power_supply", *n;
+	GDir *d = g_dir_open(dir, 0, NULL);
+	int seen = 0, online = 0;
+
+	if (!d)
+		return 0;
+	while ((n = g_dir_read_name(d))) {
+		gchar *pt = g_build_filename(dir, n, "type", NULL);
+		gchar *po = g_build_filename(dir, n, "online", NULL);
+		gchar *t = NULL, *o = NULL;
+
+		if (g_file_get_contents(pt, &t, NULL, NULL) && strncmp(t, "Battery", 7) &&
+		    g_file_get_contents(po, &o, NULL, NULL)) {
+			seen = 1;
+			online |= o[0] == '1';
+		}
+		g_free(t); g_free(o); g_free(pt); g_free(po);
 	}
+	g_dir_close(d);
 
-	lpmd_log_info("connected to upower daemon\n");
-	g_signal_connect(upower_client, "notify", G_CALLBACK(upower_daemon_cb), NULL);
-
-	devices = up_client_get_devices2(upower_client);
-	for (i = 0; i < devices->len; i++) {
-		device = g_ptr_array_index(devices, i);
-		g_signal_connect(device, "notify", G_CALLBACK(upower_daemon_cb), NULL);
-	}
+	return seen && !online;
 }
 
 /* Poll time out default */
@@ -576,7 +550,6 @@ int lpmd_main(void)
 	if (ret)
 		return ret;
 
-	connect_to_upower_daemon();
 //	 Pipe is used for communication between two processes
 	ret = pipe(wake_fds);
 	if (ret) {
-- 
2.43.0

